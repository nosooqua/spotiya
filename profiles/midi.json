{
  "version": 1,
  "leds": "station2",
  "id": "midi",
  "name": "Yandex Station 2",
  "audio": {
    "device": "default",
    "format": "S16",
    "mixer_device": "default",
    "mixer_control": "Master",
    "mixer_index": 0,
    "mixer_channel": "mono"
  },
  "voice": {
    "protocol": "quasar",
    "address": "127.0.0.1:9875"
  },
  "controls": {
    "driver": "evdev",
    "input_name": "midi_touch",
    "mapping": {
      "bindings": [
        { "code": 582, "action": "toggle" },
        { "code": 115, "action": "volume_up", "repeat": true },
        { "code": 114, "action": "volume_down", "repeat": true }
      ],
      "gestures": [
        { "from": 582, "to": 115, "action": "next" },
        { "from": 582, "to": 114, "action": "previous" }
      ],
      "gesture_ms": 250,
      "repeat_delay_ms": 450,
      "repeat_ms": 180,
      "volume_step": 5
    }
  }
}
